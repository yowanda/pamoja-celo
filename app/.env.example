# WalletConnect project ID (https://cloud.walletconnect.com)
# Required for desktop-wallet connections (RainbowKit) outside MiniPay.
NEXT_PUBLIC_WC_PROJECT_ID=

# SavingsCircle contract addresses (live deployments).
# v2 contracts include immutable protocol fee (0.5%) baked in at deploy.
# Override here if you redeploy.
NEXT_PUBLIC_SAVINGS_CIRCLE_CELO=0xc3887311dC1f340aDEB8dc640A859D84C404Fae7
NEXT_PUBLIC_SAVINGS_CIRCLE_CELO_SEPOLIA=0x276e63880B96514A5Ae9fD4774E32D620B3f0039
